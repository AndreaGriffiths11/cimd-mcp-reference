{
  "name": "cimd-mcp-reference",
  "version": "0.1.0",
  "description": "Reference remote MCP server on Cloudflare Workers that accepts OAuth clients identified by a Client ID Metadata Document (CIMD)",
  "engines": {
    "node": ">=20.11"
  },
  "files": [
    "src",
    "examples",
    "wrangler.jsonc",
    "LICENSE",
    "README.md",
    "README.es.md"
  ],
  "directories": {
    "doc": "docs",
    "example": "examples",
    "test": "test"
  },
  "scripts": {
    "test": "node --test test/client.test.mjs && vitest run",
    "dev": "wrangler dev",
    "typecheck": "tsc -p tsconfig.json",
    "deploy": "wrangler deploy",
    "example": "node examples/client/cimd-client.mjs",
    "check": "npm run typecheck && npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AndreaGriffiths11/cimd-mcp-reference.git"
  },
  "keywords": [],
  "author": "Andrea Griffiths (https://github.com/AndreaGriffiths11)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/AndreaGriffiths11/cimd-mcp-reference/issues"
  },
  "homepage": "https://github.com/AndreaGriffiths11/cimd-mcp-reference#readme",
  "private": true,
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/client": "^2.3.1",
    "@modelcontextprotocol/server": "^2.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.149.0"
  }
}
