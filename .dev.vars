# Loaded by `wrangler dev` only. This file holds no secrets and is committed on purpose.
# It lets the example client host its Client ID Metadata Document on http://127.0.0.1
# while the authorization server also runs on loopback. See README: Local development.
DEV_ALLOW_LOOPBACK_CLIENT_IDS=true
ISSUER=http://localhost:8787
# Uncomment to try the deprecated Dynamic Client Registration path:
# ENABLE_DEPRECATED_DCR=true
# Uncomment to require a password on the consent screen:
# CONSENT_PASSWORD=change-me
